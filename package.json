{
  "name": "ibphysiq",
  "version": "1.0.0",
  "private": true,
  "description": "Local IB Physics question-generation harness, review tools, and research pipeline.",
  "author": {
    "name": "melonwer",
    "url": "https://github.com/melonwer"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/melonwer/ibphysiq.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "npm run lint && npm run type-check && npm test && npm run build",
    "test": "jest --runInBand --color --testPathIgnorePatterns=cartesian-expansion-fixtures.test.ts --testPathIgnorePatterns=circuit-source-fixtures.test.ts",
    "test:research-fixtures": "jest --runInBand --color lib/visuals/__tests__/cartesian-expansion-fixtures.test.ts lib/visuals/__tests__/circuit-source-fixtures.test.ts",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint app components lib",
    "lint:fix": "npm run lint -- --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.7.1",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.16",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.4.2",
    "lucide-react": "^0.539.0",
    "next": "15.5.9",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "puppeteer": "^24.17.1",
    "tailwindcss": "^4.1.12",
    "ts-jest": "^29.4.1",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5"
  }
}
