LIT_API_URL=https://your-lit-host.example/predict
LIT_API_TOKEN=replace_with_your_lit_token

HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

LLAMA_MODEL_ID=d4ydy/ib-physics-question-generator
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key

REFINEMENT_PROVIDER=openrouter

ENABLE_REFINEMENT=true
FALLBACK_TO_ORIGINAL=true
REQUIRE_MINIMUM_QUALITY=false

NODE_ENV=development

# Human review boundary (pilot admin-token login).
# Leave REVIEW_ADMIN_TOKEN unset to disable the boundary: it refuses to run
# without one rather than falling back to an open door. Use a long random value.
REVIEW_ADMIN_TOKEN=
# Optional. When unset, the session signing key is derived from the admin token,
# which means reissuing that token invalidates every outstanding session.
REVIEW_SESSION_SECRET=
REVIEW_SESSION_TTL_MS=28800000
# Where stored question runs live. Defaults to ./data/question-runs.
REVIEW_RUN_STORE_DIR=
